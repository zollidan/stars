# DataHub image pulled from GHCR. The package is private: authenticate first with
#   echo "$GHCR_TOKEN" | docker login ghcr.io -u <github-user> --password-stdin
# or use a token with the read:packages scope.
DATAHUB_IMAGE=ghcr.io/zollidan/eva-datahub
DATAHUB_VERSION=latest

# Shared bearer token for the DataHub gRPC API. Generate one with:
#   openssl rand -hex 32
DATAHUB_SERVICE_TOKEN=

# Existing EVA DuckLake catalog (PostgreSQL URL used by DuckLake metadata).
# Point STARS at an existing DataHub deployment with STARS_EVA_ADDRESS instead if
# you do not want to run a local read-side DataHub.
DATAHUB_WRITE_CATALOG_URL=postgresql+psycopg2://betting:CHANGE_ME@host:5432/eva_lake_catalog
LAKE_S3_BUCKET=
LAKE_S3_KEY_PREFIX=lake/
S3_ENDPOINT_URL=https://storage.yandexcloud.net
S3_REGION=ru-central1
DATAHUB_WRITE_S3_ACCESS_KEY_ID=
DATAHUB_WRITE_S3_SECRET_ACCESS_KEY=

# Optional: advisory-lock database for the DataHub process. Defaults to the
# STARS PostgreSQL service. It does not have to be the same database as the
# DuckLake catalog, but DataHub and any writer must agree on one lock database.
# DATAHUB_LOCK_DATABASE_URL=postgresql+psycopg2://stars:stars@db:5432/stars

# Optional: use an already running DataHub instead of the compose profile.
# STARS_EVA_ADDRESS=http://datahub:50051
