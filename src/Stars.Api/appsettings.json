{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5080",
        "Protocols": "Http1"
      },
      "Grpc": {
        "Url": "http://0.0.0.0:5081",
        "Protocols": "Http2"
      }
    }
  },
  "Stars": {
    "AutoMigrate": true,
    "MaxRecordsPerSnapshot": 5000,
    "WorkerPollMilliseconds": 750,
    "JobBatchSize": 4,
    "Demo": {
      "Enabled": true,
      "FixtureRoot": "fixtures",
      "AutoSync": true,
      "EvaAddress": null,
      "EvaTokenEnvironmentVariable": "DATAHUB_SERVICE_TOKEN",
      "EvaMaxRecords": 300
    }
  }
}
