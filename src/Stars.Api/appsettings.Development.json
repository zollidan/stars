{
  "ConnectionStrings": {
    "Stars": "Host=localhost;Port=5432;Database=stars;Username=stars;Password=stars"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "Stars": {
    "Providers": {
      "eva": {
        "Name": "EVA DataHub",
        "ConnectorKey": "eva.datahub",
        "BaseUrl": "http://localhost:50051",
        "AuthSecretRef": "DATAHUB_SERVICE_TOKEN",
        "Enabled": true,
        "Settings": {
          "dataset": "api_sport_matches_v1"
        },
        "Feeds": {
          "api-sport": {
            "EntityKind": "match",
            "DatasetRef": "api_sport_matches_v1",
            "SyncMode": "snapshot",
            "Enabled": true,
            "Config": {}
          }
        }
      }
    }
  }
}
